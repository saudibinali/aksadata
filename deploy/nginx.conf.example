# Host Nginx in front of the production Compose web service.
# TLS certificates are expected from the host, for example Certbot.
# This file is an example. It is not installed automatically.

server {
    listen 80;
    server_name aksadata.com www.aksadata.com;
    return 301 https://aksadata.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.aksadata.com;
    # ssl_certificate     /etc/letsencrypt/live/aksadata.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/aksadata.com/privkey.pem;
    return 301 https://aksadata.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name aksadata.com;

    # ssl_certificate     /etc/letsencrypt/live/aksadata.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/aksadata.com/privkey.pem;

    client_max_body_size 10m;

    # Replace any client-supplied forwarding header with the address Nginx saw.
    # The app records this IP only when TRUST_PROXY=true.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
