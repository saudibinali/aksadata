# Copy to .env and replace every change-me value.
# Never commit .env.

# Used by Prisma CLI and by `npm run dev` on the host.
# Docker Compose overrides this inside containers so they reach the `db` service.
DATABASE_URL=postgresql://aksa:change-me@localhost:5433/aksadata

POSTGRES_USER=aksa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aksadata

APP_URL=http://localhost:3001

# Uploaded files. This path is outside the source tree and is gitignored.
MEDIA_ROOT=./var/media

# Set to true only behind the Nginx config in deploy/nginx.conf.example,
# which overwrites X-Forwarded-For with the real client address.
TRUST_PROXY=false

# Send Strict-Transport-Security only after HTTPS is working on the public domain.
ENABLE_HSTS=false

# Password hashing cost. Security parameter, not a business setting. Range 10-14.
BCRYPT_COST=12

# Optional bootstrap administrator. Leave the password empty to skip creation.
# The seed never overwrites an existing account.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
